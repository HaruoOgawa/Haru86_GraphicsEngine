void main(){
	uint DID=gl_GlobalInvocationID.x;
    uint GID=gl_WorkGroupID.x;

    ////Boids Main///////////////////////
    
     BoidsData my_boids_data=outBufferBoidsData.boidsData[DID];
     vec3 my_position=my_boids_data.position;
     vec3 my_velocity=my_boids_data.velocity;

    vec3 joinVal=vec3(0,0,0);
    vec3 separateVal=vec3(0,0,0);
    vec3 alignmentVal=vec3(0,0,0);

    float joinCount=0;
    float separateCount=0;
    float alignmentCount=0;

    vec3 joinPosSum=vec3(0,0,0);
    vec3 separateVectorSum=vec3(0,0,0);
    vec3 alignmentVectorSum=vec3(0,0,0);

    vec3 separateForce=vec3(0,0,0);
    vec3 alignmentForce=vec3(0,0,0);

    vec3 result_velocity=(vec3)my_velocity;

     vec3 centerPos=vec3(0,0,0);
     float smallT=0.1;
    centerPos=vec3(cos(_time*smallT)*_centerPosPower,0.,sin(_time*smallT)*_centerPosPower);
    centerPos=vec3(0,0,_time*_centerPosPower);

    float disMin=100000000.0;
    float disMax=-10000000.0;

    float speed=0.005;
    
    for(int i=0;i<_boids_count;i+=255){
        shared_BoidsData[GID]=outBufferBoidsData.boidsData[i+GID];
        
        groupMemoryBarrier();

        for(int q=0;q<255;q++){
            vec3 other_position=shared_BoidsData[q].position;
            vec3 other_velocity=shared_BoidsData[q].velocity;

            float dis=length(other_position-my_position);
            dis=abs(dis);

            //join
            if(dis>0&&dis<=_joinDisMin){
                vec3 dirPos=other_position;
                joinPosSum+=dirPos*(1.0/dis);
                joinCount++;
            }
            //separate
            if(dis>0&&dis<=_separateDistMin){
                vec3 dirVector=other_position-my_position;
                separateVectorSum-=dirVector*(1.0/dis);
                separateCount++;
            }
            //alignment
            if(dis>0&&dis<=_alignmentDistMin){
                alignmentVectorSum+=other_velocity*(1.0/dis);
                alignmentCount++;
            }
            disMin=min(disMin,dis);
            disMax=max(disMax,dis);
            
        }

        GroupMemoryBarrierWithGroupSync();

    }


   

     if(joinCount>0){
        //joinForce
        joinForce.x=joinPosSum.x/(float)joinCount;
        joinForce.y=joinPosSum.y/(float)joinCount;
        joinForce.z=joinPosSum.z/(float)joinCount;
        joinForce=joinForce-my_position;
        joinForce=normalize(joinForce)*speed;
        
        result_velocity+=(float3)joinForce*_joinPower;
        
       
    }

     if(separateCount>0){
        //separateForce
        separateForce.x=separateVectorSum.x/(float)separateVectorSum;
        separateForce.y=separateVectorSum.y/(float)separateVectorSum;
        separateForce.z=separateVectorSum.z/(float)separateVectorSum;
        separateForce=separateForce-my_position;
        separateForce=normalize(separateForce)*speed;

      
        result_velocity+=(vec3)separateForce*_separatePower;
        
        
    }

     if(alignmentCount>0){
        //alignmentForce
        alignmentForce.x=alignmentVectorSum.x/(float)alignmentCount;
        alignmentForce.y=alignmentVectorSum.y/(float)alignmentCount;
        alignmentForce.z=alignmentVectorSum.z/(float)alignmentCount;
        alignmentForce=alignmentForce-my_position;
        alignmentForce=normalize(alignmentForce)*speed;

        result_velocity+=(vec3)alignmentForce*_alignmentPower;
    
    }
    vec3 previous_result_velocity=result_velocity;
    result_velocity+=vec3(rand(vec2((float)DID.x,0.123))*2.0-1.0,rand(vec2((float)DID,0.456))*2.0-1.0,rand(vec2((float)DID,0.789))*2.0-1.0)*_NoiseValue;
    result_velocity=Turn(my_position,result_velocity,(float)DID.x);

    vec3 noiseVector=normalize(cross(result_velocity,vec3(0.,0.,1.)));
    noiseVector=noiseVector*perlinNoise(vec2(_deltaTime,(float)DID.x))*0.2;
    result_velocity+=noiseVector;

    outBufferBoidsForce.boidsForce[DID]=result_velocity;
    
   
